<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs / FindSecBugs suppressions. Every entry must explain why the finding is a false positive
  or an accepted risk. Keep this list short; prefer fixing the code.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      The optimizer's Iterated Local Search uses a seeded SplittableRandom on purpose: plans must be
      reproducible for identical input. The values never protect anything (no tokens, no IDs).
    -->
    <Match>
        <Package name="~dev\.tabiji\.optimizer(\..*)?"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>
</FindBugsFilter>
