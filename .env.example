# Settings for compose.yaml. Copy to .env and fill in; .env is git-ignored and must never be committed.

# Password of the PostgreSQL role the API uses. Any long random value, for example the output of:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. When set, the API creates demo@tabiji.example with a sample Tokyo trip on first start.
# The password policy applies: 12-128 characters, not a common password, and it must not contain the
# e-mail address or its local part (so no "demo"). For example: openssl rand -base64 18
TABIJI_DEMO_PASSWORD=

# Optional. Host port of the app; it is bound to 127.0.0.1 only.
TABIJI_PORT=3000
